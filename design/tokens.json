{
  "$description": "Hospitrend design tokens, direction C · Concierge. Source of truth for tokens.css and the Tailwind theme. Every text/background pair is checked by check-contrast.mjs (WCAG AA).",
  "font": {
    "family": {
      "sans": "\"Manrope\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
    },
    "weight": { "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 },
    "size": {
      "xs": "12px",
      "sm": "13px",
      "base-sm": "14px",
      "md": "15px",
      "base": "16px",
      "lg": "17px",
      "xl": "22px",
      "2xl": "23px",
      "3xl": "26px",
      "4xl": "28px",
      "5xl": "32px"
    },
    "lineHeight": { "tight": 1.2, "snug": 1.3, "normal": 1.45, "relaxed": 1.55 }
  },
  "radius": {
    "sm": "12px",
    "md": "14px",
    "lg": "16px",
    "xl": "20px",
    "card": "24px",
    "pill": "999px"
  },
  "space": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "14": "56px"
  },
  "size": {
    "touch-min": "44px",
    "button": "52px",
    "button-lg": "56px",
    "action-main": "72px",
    "action-side": "48px",
    "nav": "60px"
  },
  "color": {
    "light": {
      "bg": "#F4F6FA",
      "surface": "#FFFFFF",
      "surface-muted": "#F4F6FA",
      "border": "#E2E8F0",
      "border-strong": "#7E8899",
      "text": "#14213D",
      "text-body": "#2D3748",
      "text-muted": "#4A5568",
      "primary": "#14213D",
      "on-primary": "#FFFFFF",
      "accent": "#C2410C",
      "on-accent": "#FFFFFF",
      "accent-text": "#9A3412",
      "idea-bg": "#FFF4E8",
      "idea-fg": "#7C2D12",
      "danger": "#B91C1C",
      "nav-bg": "#14213D",
      "nav-fg": "#FFFFFF",
      "nav-active-bg": "#FFFFFF",
      "nav-active-fg": "#14213D",
      "placeholder": "#5A6578",
      "shadow-card": "0 8px 24px rgba(20, 33, 61, 0.10)"
    },
    "dark": {
      "bg": "#0E1526",
      "surface": "#182238",
      "surface-muted": "#0E1526",
      "border": "#2A3651",
      "border-strong": "#7A88A3",
      "text": "#F1F4F9",
      "text-body": "#DCE2EC",
      "text-muted": "#B4BFD0",
      "primary": "#F1F4F9",
      "on-primary": "#0E1526",
      "accent": "#FF8A5B",
      "on-accent": "#0E1526",
      "accent-text": "#FF9F7A",
      "idea-bg": "#3A2214",
      "idea-fg": "#FFD9C2",
      "danger": "#FF8A8A",
      "nav-bg": "#22304A",
      "nav-fg": "#F1F4F9",
      "nav-active-bg": "#F1F4F9",
      "nav-active-fg": "#0E1526",
      "placeholder": "#8E9AB0",
      "shadow-card": "none"
    }
  },
  "themeColor": {
    "$description": "Each topic of docs/sujets.md maps to one tint. A tint is a pair: bg (chip background) and fg (chip text, also used alone as the topic label color on a surface).",
    "tints": {
      "light": {
        "blue":   { "bg": "#DBEAFE", "fg": "#1E3A8A" },
        "orange": { "bg": "#FFEDD5", "fg": "#9A3412" },
        "green":  { "bg": "#DCFCE7", "fg": "#166534" },
        "violet": { "bg": "#EDE9FE", "fg": "#5B21B6" },
        "slate":  { "bg": "#E2E8F0", "fg": "#334155" }
      },
      "dark": {
        "blue":   { "bg": "#1E3A6B", "fg": "#BFD7FF" },
        "orange": { "bg": "#5A2A12", "fg": "#FFD0B0" },
        "green":  { "bg": "#14432A", "fg": "#B6F0C8" },
        "violet": { "bg": "#3B2A6B", "fg": "#DCCFFF" },
        "slate":  { "bg": "#2A3445", "fg": "#D5DDE8" }
      }
    },
    "topics": {
      "hospitality": "blue",
      "tourism": "orange",
      "mice": "orange",
      "wellness": "green",
      "distribution": "blue",
      "hotel-tech": "violet",
      "guest-experience": "violet",
      "food-beverage": "orange",
      "sustainability": "green",
      "hr": "slate",
      "regulation": "slate",
      "transport": "blue",
      "design": "violet"
    }
  },
  "contrastPairs": {
    "$description": "Pairs that appear in the designs. text = 4.5:1 minimum, ui = 3:1 minimum (borders, icons, focus).",
    "text": [
      ["text", "bg"], ["text", "surface"], ["text-body", "surface"], ["text-muted", "bg"], ["text-muted", "surface"],
      ["on-primary", "primary"], ["on-accent", "accent"], ["accent-text", "bg"], ["accent-text", "surface"],
      ["idea-fg", "idea-bg"], ["danger", "surface"], ["nav-fg", "nav-bg"], ["nav-active-fg", "nav-active-bg"],
      ["placeholder", "surface"]
    ],
    "ui": [["border-strong", "surface"], ["border-strong", "bg"]]
  }
}
