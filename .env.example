# Copy this file to .env.local (never commit .env.local) and fill in the values.
# On Vercel, add the same variables in Project > Settings > Environment Variables.

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Secret key: server only. Used by the daily ingestion and to delete unauthorised accounts.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Google accounts allowed to sign in, comma-separated.
ALLOWED_EMAILS=claire@example.com
# Allowed accounts that are also administrators (source admin page, V1).
ADMIN_EMAILS=

# Any long random string. Vercel Cron sends it to /api/cron/ingest.
CRON_SECRET=change-me-to-a-long-random-string
